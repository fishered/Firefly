# One release version is shared by the Server and Admin UI images.
FIREFLY_VERSION=1.1.0

# Storage profile: pg, h2, or memory.
# h2 and memory use the image defaults and do not need the PostgreSQL settings below.
FIREFLY_CONFIG_PROFILE=pg

# PostgreSQL-only settings. Remove or comment out these six entries for h2 or memory.
# Use the Compose service name "postgres", not 127.0.0.1.
# For an external database, replace it with a hostname reachable from the container.
FIREFLY_STORE_TYPE=jdbc
FIREFLY_JDBC_URL=jdbc:postgresql://postgres:5432/firefly
FIREFLY_JDBC_USERNAME=firefly
FIREFLY_JDBC_PASSWORD=change-me-database-password
FIREFLY_JDBC_DIALECT=postgresql
FIREFLY_JDBC_SCHEMA_MODE=initialize-if-empty

# Firefly node identity and roles.
FIREFLY_NODE_MODE=standalone
FIREFLY_NODE_NAME=firefly-standalone
FIREFLY_NODE_ROLES=api,gateway,scheduler
FIREFLY_PLUGINS=metrics-prometheus

# Optional OTLP/HTTP tracing. Executors use their own OpenTelemetry SDK or Java agent.
FIREFLY_TRACING_OPENTELEMETRY_ENABLED=false
FIREFLY_TRACING_OPENTELEMETRY_ENDPOINT=http://otel-collector:4318/v1/traces
FIREFLY_TRACING_OPENTELEMETRY_SERVICE_NAME=firefly
FIREFLY_TRACING_OPENTELEMETRY_SAMPLING_RATIO=0.25
FIREFLY_TRACING_OPENTELEMETRY_EXPORT_TIMEOUT_MS=10000

# Authentication defaults to enabled for pg and disabled for h2/memory.
# Set FIREFLY_SECURITY_JWT_ENABLED only when overriding the selected profile.
FIREFLY_SECURITY_JWT_ISSUER=firefly
FIREFLY_SECURITY_JWT_SECRET=change-me-to-a-long-random-signing-secret
FIREFLY_EXECUTOR_REGISTRATION_AUTO_CREATE_DEFINITION=true

# Published host ports.
FIREFLY_GATEWAY_PORT=9700
FIREFLY_ADMIN_API_PORT=9710
FIREFLY_METRICS_PORT=9711
FIREFLY_ADMIN_UI_PORT=9720

# UI session and JVM defaults.
FIREFLY_ADMIN_SESSION_IDLE_TIMEOUT=30m
FIREFLY_ADMIN_SESSION_COOKIE_SECURE=false
FIREFLY_ADMIN_API_TIMEOUT_MS=5000
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
